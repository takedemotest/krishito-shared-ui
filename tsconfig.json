/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "paths": {
      "krishito-ui-agGrid": ["./dist/krishito-ui-ag-grid"],
      "krishito-ui-card": ["./dist/krishito-ui-card"],
      "krishito-ui-form": ["./dist/krishito-ui-form"],
      "krishito-ui-graph": ["./dist/krishito-ui-graph"],
      "krishito-ui-icons": ["./dist/krishito-ui-icons"],
      "krishito-ui-navigation": ["./dist/krishito-ui-navigation"],
      "krishito-ui-slider": ["./dist/krishito-ui-slider"],
      "shared-ui": ["./dist/shared-ui"]
    },
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
